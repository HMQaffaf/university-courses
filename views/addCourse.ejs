<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="uop-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="icon-box">
          <i class="bi bi-journal-plus"></i>
        </div>
        <div>
          <h3 class="fw-extrabold mb-0">Add Course Section</h3>
          <p class="text-secondary small mb-0">Publish a new lecture section to the MongoDB course catalog</p>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger small rounded-3"><%= error %></div>
      <% } %>

      <form action="/courses/add" method="POST">
        <div class="mb-3">
          <label class="form-label small fw-bold text-secondary">Course Subject Name</label>
          <input type="text" class="form-control" name="name" placeholder="e.g. Cloud Computing & Microservices" required>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-bold text-secondary">Instructor Name</label>
          <input type="text" class="form-control" name="teacher" placeholder="e.g. Dr. Ahmad Al-Mansour" required>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <label class="form-label small fw-bold text-secondary">Start Time</label>
            <input type="text" class="form-control" name="startTime" placeholder="e.g. 10:00 AM" required>
          </div>
          <div class="col-sm-6">
            <label class="form-label small fw-bold text-secondary">End Time</label>
            <input type="text" class="form-control" name="endTime" placeholder="e.g. 11:30 AM" required>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-uop-primary flex-grow-1">
            <i class="bi bi-plus-circle me-1"></i> Save Course Section
          </button>
          <a href="/courses" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
