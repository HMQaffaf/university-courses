<%- include('partials/header') %>

<div class="mb-4">
  <a href="/courses" class="btn btn-outline-secondary btn-sm rounded-3 px-3">
    <i class="bi bi-arrow-left me-1"></i> Back to Course Catalog
  </a>
</div>

<% if (typeof query !== 'undefined' && query.enrolled) { %>
  <div class="alert alert-success d-flex align-items-center justify-content-between rounded-4 shadow-sm mb-4" role="alert">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-check-circle-fill fs-5"></i>
      <div><strong>Enrollment Confirmed!</strong> This section has been added to your semester schedule.</div>
    </div>
    <a href="/my-courses" class="btn btn-success btn-sm rounded-3">View My Schedule</a>
  </div>
<% } %>

<div class="uop-card p-4 mb-4 bg-white border-start border-4 border-primary">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <span class="badge bg-primary bg-opacity-10 text-primary mb-2">Course Sections & Timetables</span>
      <h2 class="fw-extrabold mb-1"><%= courseName %></h2>
      <p class="text-secondary small mb-0">Choose a suitable lecture time slot and instructor below to enroll.</p>
    </div>
    <a href="/my-courses" class="btn btn-outline-primary rounded-3 fw-semibold">
      <i class="bi bi-calendar2-week me-1"></i> My Registered Courses
    </a>
  </div>
</div>

<div class="row g-4">
  <% courses.forEach((course, index) => { 
       const isEnrolled = typeof enrolledIds !== 'undefined' && enrolledIds.includes(course._id.toString());
  %>
    <div class="col-md-6">
      <div class="uop-card uop-card-hover p-4 h-100 d-flex flex-column justify-content-between">
        <div>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-dark rounded-pill px-3 py-2">Section #<%= index + 1 %></span>
            <% if (isEnrolled) { %>
              <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                <i class="bi bi-check2-circle me-1"></i> Registered
              </span>
            <% } else { %>
              <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">Open Seat</span>
            <% } %>
          </div>

          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-box" style="width: 48px; height: 48px;">
              <i class="bi bi-person-video3"></i>
            </div>
            <div>
              <div class="small text-secondary">Course Instructor</div>
              <h5 class="fw-bold mb-0"><%= course.teacher %></h5>
            </div>
          </div>

          <div class="p-3 bg-light rounded-3 mb-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2 text-secondary small fw-semibold">
              <i class="bi bi-clock-history text-primary"></i>
              <span>Lecture Schedule</span>
            </div>
            <span class="fw-bold text-dark"><%= course.startTime %> — <%= course.endTime %></span>
          </div>
        </div>

        <% if (isEnrolled) { %>
          <div class="d-flex gap-2">
            <button class="btn btn-success w-100 rounded-3 fw-semibold" disabled>
              <i class="bi bi-check2-all me-1"></i> Already Enrolled
            </button>
            <a href="/remove/<%= course._id %>" class="btn btn-outline-danger rounded-3 px-3" title="Drop Section">
              <i class="bi bi-trash"></i>
            </a>
          </div>
        <% } else { %>
          <a href="/enroll/<%= course._id %>" class="btn btn-uop-primary w-100">
            <i class="bi bi-plus-circle me-1"></i> Enroll in This Section
          </a>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
