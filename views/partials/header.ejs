<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UOP Academic Portal | University of Petra</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark uop-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand uop-brand" href="/">
      <img src="/images/university_logo.png" class="uop-brand-logo" alt="UOP" onerror="this.style.display='none'">
      <span>UOP <span class="text-primary fw-extrabold" style="color: #60a5fa !important;">PORTAL</span></span>
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#uopNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="uopNavbar">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
        <li class="nav-item">
          <a class="nav-link uop-nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link uop-nav-link <%= currentPath.startsWith('/course') ? 'active' : '' %>" href="/courses">
            <i class="bi bi-journal-bookmark me-1"></i> Course Catalog
          </a>
        </li>
        <% if (userLoggedIn) { %>
          <li class="nav-item">
            <a class="nav-link uop-nav-link <%= currentPath === '/my-courses' ? 'active' : '' %>" href="/my-courses">
              <i class="bi bi-calendar2-check me-1"></i> My Schedule
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link uop-nav-link <%= currentPath === '/add-course' ? 'active' : '' %>" href="/add-course">
              <i class="bi bi-plus-circle me-1"></i> Add Section
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link uop-nav-link <%= currentPath === '/profile' ? 'active' : '' %>" href="/profile">
              <i class="bi bi-person-badge me-1"></i> Academic Profile
            </a>
          </li>
        <% } %>
      </ul>

      <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
        <% if (!userLoggedIn) { %>
          <a href="/login" class="btn btn-outline-light btn-sm px-3 py-2 rounded-3 fw-semibold">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
          </a>
          <a href="/register" class="btn btn-primary btn-sm px-3 py-2 rounded-3 fw-semibold">
            <i class="bi bi-person-plus me-1"></i> Register
          </a>
        <% } else { %>
          <a href="/profile" class="btn btn-dark btn-sm px-3 py-2 rounded-3 border border-secondary text-light d-flex align-items-center gap-2">
            <i class="bi bi-person-circle text-info"></i>
            <span><%= currentUsername || 'Student' %></span>
          </a>
          <a href="/logout" class="btn btn-danger btn-sm px-3 py-2 rounded-3 fw-semibold">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<main class="main-wrapper py-4 py-md-5">
  <div class="container">
