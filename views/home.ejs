<%- include('partials/header') %>

<!-- Hero Section -->
<section class="uop-hero p-4 p-md-5 mb-5">
  <div class="row align-items-center gy-4 py-2">
    <div class="col-lg-7">
      <div class="uop-badge-pill mb-3">
        <i class="bi bi-shield-check text-warning"></i>
        <span>University of Petra • Smart Academic Portal 2026</span>
      </div>
      <h1 class="display-5 fw-extrabold mb-3" style="line-height: 1.18;">
        Empowering Future Leaders Through Digital Excellence
      </h1>
      <p class="lead text-light opacity-75 mb-4">
        Browse university courses, manage your semester schedule in real time, and access your student portal seamlessly with Google OAuth & JWT security.
      </p>
      <div class="d-flex flex-wrap gap-3">
        <a href="/courses" class="btn btn-light btn-lg px-4 fw-bold text-primary rounded-3 shadow-sm">
          <i class="bi bi-journal-code me-2"></i>Explore Course Catalog
        </a>
        <% if (!userLoggedIn) { %>
          <a href="/login" class="btn btn-outline-light btn-lg px-4 fw-semibold rounded-3">
            <i class="bi bi-google me-2"></i>Sign In with Google
          </a>
        <% } else { %>
          <a href="/my-courses" class="btn btn-outline-light btn-lg px-4 fw-semibold rounded-3">
            <i class="bi bi-calendar-check me-2"></i>View My Schedule
          </a>
        <% } %>
      </div>

      <div class="row g-3 mt-4 pt-2">
        <div class="col-4">
          <div class="stat-pill text-center">
            <h4 class="fw-bold mb-0 text-white">10,000+</h4>
            <small class="text-light opacity-75">Active Students</small>
          </div>
        </div>
        <div class="col-4">
          <div class="stat-pill text-center">
            <h4 class="fw-bold mb-0 text-white">QS 5-Star</h4>
            <small class="text-light opacity-75">Global Rating</small>
          </div>
        </div>
        <div class="col-4">
          <div class="stat-pill text-center">
            <h4 class="fw-bold mb-0 text-white">100%</h4>
            <small class="text-light opacity-75">Cloud & OAuth</small>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5 text-center">
      <div class="position-relative">
        <img src="/images/campus.jpg" class="img-fluid rounded-4 shadow-lg border border-3 border-light border-opacity-25" alt="University Campus" style="max-height: 360px; width: 100%; object-fit: cover;">
        <div class="bg-white text-dark p-3 rounded-4 shadow position-absolute bottom-0 start-0 m-3 d-none d-sm-flex align-items-center gap-3">
          <div class="icon-box-emerald icon-box" style="width: 42px; height: 42px;">
            <i class="bi bi-patch-check-fill"></i>
          </div>
          <div class="text-start">
            <div class="fw-bold small">Accredited Programs</div>
            <div class="text-muted" style="font-size: 0.78rem;">Theory & Practical Innovation</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- About & Key Portal Features -->
<section class="mb-5">
  <div class="row align-items-center g-4">
    <div class="col-lg-5">
      <span class="text-primary fw-bold text-uppercase small">About Our Institution</span>
      <h2 class="fw-extrabold mt-1 mb-3">Why University of Petra?</h2>
      <p class="text-secondary mb-4">
        University of Petra delivers high-quality higher education combining rigorous theoretical foundations with hands-on industry skills, preparing graduates to lead in technology, business, and research.
      </p>
      <div class="d-flex flex-column gap-3">
        <div class="d-flex align-items-start gap-3">
          <div class="icon-box flex-shrink-0" style="width: 44px; height: 44px;">
            <i class="bi bi-shield-lock-fill"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Unified Google OAuth & JWT Security</h6>
            <p class="small text-secondary mb-0">One-click student login backed by Firebase Authentication and JSON Web Tokens.</p>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <div class="icon-box icon-box-emerald flex-shrink-0" style="width: 44px; height: 44px;">
            <i class="bi bi-database-check"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1">Real-Time MongoDB Course Enrollment</h6>
            <p class="small text-secondary mb-0">Instant course registration, section selection, and personal schedule tracking.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="uop-card p-3">
        <img src="/images/university_banner.jpg" class="img-fluid rounded-3 w-100" alt="University Banner" style="max-height: 310px; object-fit: cover;">
      </div>
    </div>
  </div>
</section>

<!-- Achievements & Awards -->
<section class="mb-5">
  <div class="text-center mb-4">
    <span class="text-primary fw-bold text-uppercase small">Global Recognition</span>
    <h2 class="fw-extrabold mt-1">Achievements & Academic Awards</h2>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="uop-card uop-card-hover p-4 h-100 text-center">
        <div class="award-img-wrapper">
          <img src="/images/award1.jpg" alt="QS Star Rating">
        </div>
        <span class="badge bg-primary bg-opacity-10 text-primary mb-2">International Quality</span>
        <h5 class="fw-bold">QS Stars University Rating</h5>
        <p class="small text-secondary mb-0">
          Recognized for excellence in teaching quality, employability, academic development, and modern campus facilities.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="uop-card uop-card-hover p-4 h-100 text-center">
        <div class="award-img-wrapper">
          <img src="/images/award2.jpg" alt="World University Rankings">
        </div>
        <span class="badge bg-success bg-opacity-10 text-success mb-2">Global Ranking</span>
        <h5 class="fw-bold">World University Rankings</h5>
        <p class="small text-secondary mb-0">
          Ranked among leading regional and international universities for academic reputation and impactful research output.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="uop-card uop-card-hover p-4 h-100 text-center">
        <div class="award-img-wrapper">
          <img src="/images/award3.jpg" alt="Innovation & Creativity Awards">
        </div>
        <span class="badge bg-warning bg-opacity-15 text-dark mb-2">Student Excellence</span>
        <h5 class="fw-bold">Innovation & Creativity Awards</h5>
        <p class="small text-secondary mb-0">
          Awarded for pioneering student graduation projects, entrepreneurship incubators, and technological innovation.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Campus Location Map -->
<section class="mb-3">
  <div class="uop-card overflow-hidden">
    <div class="p-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill text-primary me-2"></i>University of Petra Campus</h5>
        <p class="small text-secondary mb-0">Airport Road, Amman, Jordan</p>
      </div>
      <a href="/courses" class="btn btn-uop-primary btn-sm">Browse Available Courses</a>
    </div>
    <div class="ratio ratio-21x9" style="max-height: 360px;">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3387.351248526305!2d35.873292!3d31.897131!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x151ca7e47722d561%3A0x6d119327564a6c2!2sUniversity%20of%20Petra!5e0!3m2!1sen!2sjo!4v1700000000000!5m2!1sen!2sjo" 
        style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
