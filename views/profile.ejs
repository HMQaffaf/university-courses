<%- include('partials/header') %>

<div class="row g-4 align-items-start">
  <!-- Student Identity Card -->
  <div class="col-lg-4">
    <div class="uop-card p-4 text-center">
      <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white fw-extrabold shadow"
           style="width: 88px; height: 88px; font-size: 2.2rem; background: linear-gradient(135deg, #1e3a8a, #2563eb);">
        <%= (profile.name || 'S').charAt(0).toUpperCase() %>
      </div>
      <h4 class="fw-extrabold mb-1"><%= profile.name %></h4>
      <p class="text-secondary small mb-3"><%= profile.email %></p>

      <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-success bg-opacity-10 text-success small fw-semibold mb-4">
        <i class="bi bi-shield-fill-check"></i>
        <span><%= profile.authMethod || 'Google OAuth & JWT Verified' %></span>
      </div>

      <div class="border-top pt-3 text-start small">
        <div class="d-flex justify-content-between py-2 border-bottom">
          <span class="text-secondary">Faculty</span>
          <strong class="text-dark">Information Technology</strong>
        </div>
        <div class="d-flex justify-content-between py-2 border-bottom">
          <span class="text-secondary">Academic Major</span>
          <strong class="text-dark">Computer Science</strong>
        </div>
        <div class="d-flex justify-content-between py-2">
          <span class="text-secondary">Academic Standing</span>
          <strong class="text-success">Excellent (Honor List)</strong>
        </div>
      </div>

      <div class="d-grid gap-2 mt-4">
        <a href="/courses" class="btn btn-uop-primary">
          <i class="bi bi-journal-plus me-1"></i> Register New Courses
        </a>
        <a href="/my-courses" class="btn btn-outline-primary rounded-3 fw-semibold">
          <i class="bi bi-calendar2-check me-1"></i> View My Schedule
        </a>
        <a href="/logout" class="btn btn-outline-danger rounded-3 fw-semibold mt-1">
          <i class="bi bi-box-arrow-right me-1"></i> Sign Out
        </a>
      </div>
    </div>
  </div>

  <!-- Academic Progress & Registered Courses -->
  <div class="col-lg-8">
    <div class="row g-3 mb-4">
      <div class="col-sm-4">
        <div class="uop-card p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-secondary fw-semibold">Cumulative GPA</span>
            <i class="bi bi-graph-up-arrow text-primary fs-5"></i>
          </div>
          <h3 class="fw-extrabold mb-1">3.40 <small class="text-secondary fs-6 fw-normal">/ 4.00</small></h3>
          <div class="progress mt-2" style="height: 6px;">
            <div class="progress-bar bg-primary" style="width: 85%"></div>
          </div>
        </div>
      </div>

      <div class="col-sm-4">
        <div class="uop-card p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-secondary fw-semibold">Passed Hours</span>
            <i class="bi bi-mortarboard text-success fs-5"></i>
          </div>
          <h3 class="fw-extrabold mb-1">91 <small class="text-secondary fs-6 fw-normal">/ 132 Cr.</small></h3>
          <div class="progress mt-2" style="height: 6px;">
            <div class="progress-bar bg-success" style="width: 69%"></div>
          </div>
        </div>
      </div>

      <div class="col-sm-4">
        <div class="uop-card p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-secondary fw-semibold">Current Semester</span>
            <i class="bi bi-bookmark-check text-warning fs-5"></i>
          </div>
          <h3 class="fw-extrabold mb-1"><%= (profile.courses ? profile.courses.length : 0) * 3 %> <small class="text-secondary fs-6 fw-normal">Cr. Hrs</small></h3>
          <small class="text-secondary"><%= profile.courses ? profile.courses.length : 0 %> Enrolled Courses</small>
        </div>
      </div>
    </div>

    <!-- Current Registered Courses Preview -->
    <div class="uop-card p-4">
      <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h5 class="fw-bold mb-0"><i class="bi bi-calendar-week text-primary me-2"></i>Current Semester Schedule</h5>
        <a href="/my-courses" class="small text-primary fw-bold text-decoration-none">Manage Schedule &rarr;</a>
      </div>

      <% if (!profile.courses || profile.courses.length === 0) { %>
        <div class="text-center py-4">
          <p class="text-secondary small mb-3">You have no registered courses for this semester yet.</p>
          <a href="/courses" class="btn btn-sm btn-uop-primary">Browse Course Catalog</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light small text-secondary">
              <tr>
                <th>Course Name</th>
                <th>Instructor</th>
                <th>Schedule</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% profile.courses.forEach(course => { %>
                <tr>
                  <td class="fw-bold"><%= course.name %></td>
                  <td class="text-secondary small"><%= course.teacher %></td>
                  <td><span class="badge bg-light text-dark border"><%= course.startTime %> - <%= course.endTime %></span></td>
                  <td class="text-end">
                    <a href="/remove/<%= course._id %>" class="btn btn-sm btn-outline-danger rounded-3">Drop</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
